# Copy to .env (gitignored). Every value that needs the owner's input lives here.

# Postgres. Local default is the docker-compose database on port 5434.
# Production (Vercel) uses the read-only role pid_reader on Neon.
DATABASE_URL=postgresql://pid:pid_local_dev@localhost:5434/pid

# Plain-English query bar. Without it, /api/nlq returns 503 and the UI says so.
# PLACEHOLDER: set a key with a monthly spend limit in the Anthropic console; the endpoint is public.
ANTHROPIC_API_KEY=

# Optional overrides
# NLQ_MODEL=claude-opus-5-5
# NLQ_MAX_ROWS=500
# NLQ_STATEMENT_TIMEOUT_MS=5000
